# Zernio API
ZERNIO_API_KEY=your_zernio_api_key
ZERNIO_WEBHOOK_SECRET=your_zernio_webhook_secret
ZERNIO_ACCOUNT_ID=your_connected_account_id
ZERNIO_PROFILE_ID=your_profile_id

# Media (optional — base URL for hosted audio/image/video files)
MEDIA_BASE_URL=https://your-cdn.com/media

# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Admin
ADMIN_API_KEY=your_admin_api_key

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (optional — omit RESEND_API_KEY to disable email features)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Your Brand <noreply@yourdomain.com>
WELCOME_EMAIL_TEMPLATE=bienvenido.html